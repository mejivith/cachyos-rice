{
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/2.66.0/doc/json_schema.json",
"logo": {
  "type": "kitty",
  "source": "~/.config/fastfetch/logo.png",
  "width": 25,
  "padding": {
    "top": 1,
    "right": 6
  }
},
  "display": {
    "separator": "  "
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": " Hey, Asphyxiator!"
    },
    {
      "type": "custom",
      "format": "╭──────────────────────────────────────────────╮",
      "outputColor": "33"
    },
    {
      "type": "os",
      "key": "│  OS",
      "keyColor": "33",
      "format": "                               {pretty-name} {#33}│{#}"
    },
    {
      "type": "kernel",
      "key": "│  Kernel",
      "keyColor": "33",
      "format": "                   {release} {#33}│{#}"
    },
    {
      "type": "packages",
      "key": "│  Packages",
      "keyColor": "33",
      "format": "                   {all} (pacman) {#33}│{#}"
    },
    {
      "type": "shell",
      "key": "│  Shell",
      "keyColor": "33",
      "format": "                               {pretty-name} {#33}│{#}"
    },
    {
      "type": "terminal",
      "key": "│  Terminal",
      "keyColor": "33",
      "format": "                           {pretty-name} {#33}│{#}"
    },
    {
      "type": "wm",
      "key": "│  WM",
      "keyColor": "33",
      "format": "                                  {pretty-name} {#33}│{#}"
    },
{
  "type": "command",
  "key": "│  Uptime",
  "keyColor": "33",
  "text": "awk '{t=$1; d=int(t/86400); h=int(t%86400/3600); m=int(t%3600/60); printf \"%24s %dd %dh %02dm \\033[38;5;108m│\\033[0m\", \"\", d, h, m}' /proc/uptime"
},
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────╯",
      "outputColor": "33"
    },
    "break"
  ]
}
